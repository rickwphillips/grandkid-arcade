{
  "threshold": 3,
  "reporters": ["console"],
  "gitignore": true,
  "format": ["typescript", "tsx", "javascript", "jsx", "css", "scss", "sass"],
  "ignore": [
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/out/**",
    "**/build/**",
    "**/coverage/**",
    "**/*.min.*",
    "**/*.map",
    "**/*.test.*",
    "**/*.spec.*",
    "**/e2e/**",
    "**/tests/**"
  ]
}
